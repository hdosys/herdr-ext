+            ["ws_2", "ws_3"]
+        } else {
+            ["ws_3", "ws_2"]
+        };
+        let remote_ids: &[&str] = if !show_child {
+            &["ws_1", "ws_2"]
+        } else if compact {
+            &["ws_1", "ws_2", "ws_3"]
+        } else {
+            &["ws_1", "ws_3", "ws_2"]
+        };
+        for (endpoint, ids) in [
+            (&ClientEndpointId::Local, local.as_slice()),
+            (&remote, remote_ids),
+        ] {
+            for id in ids {
+                preview_key(&mut state, b"\x1b[B");
