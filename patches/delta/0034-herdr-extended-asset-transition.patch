 src/update.rs | 78 +++++++++++++++++++++++++++++++++++++++------------
 1 file changed, 60 insertions(+), 18 deletions(-)

diff --git a/src/update.rs b/src/update.rs
index 392567d5d3525aaede1a6678a821b54a38675289..782459f8f31bd802ce67c311b784a8ea1c059139 100644
--- a/src/update.rs
+++ b/src/update.rs
@@ -320,7 +320,10 @@ fn update_asset_key(os: &str, arch: &str) -> String {
     }
 }
 
-fn expected_release_asset_name(asset_key: &str, release_version: ReleaseVersion) -> Option<String> {
+fn expected_release_asset_names(
+    asset_key: &str,
+    release_version: ReleaseVersion,
+) -> Option<[String; 2]> {
     let suffix = match asset_key {
         "linux-x86_64" => "linux_amd64",
         "linux-aarch64" => "linux_arm64",
@@ -330,7 +333,35 @@ fn expected_release_asset_name(asset_key: &str, release_version: ReleaseVersion)
         "windows-x86_64-installer" => "windows_amd64_setup.exe",
         _ => return None,
     };
-    Some(format!("herdr-win_v{release_version}_{suffix}"))
+    Some([
+        format!("herdr-win_v{release_version}_{suffix}"),
+        format!("herdr-ext_v{release_version}_{suffix}"),
+    ])
+}
+
+fn validated_release_asset_name(
+    asset_key: &str,
+    asset_url: &str,
+    release_version: ReleaseVersion,
+) -> Result<String, String> {
+    let names = expected_release_asset_names(asset_key, release_version)
+        .ok_or_else(|| format!("unsupported preview asset target {asset_key}"))?;
+    for name in &names {
+        let expected_url = format!(
+            "{}v{release_version}/{name}",
+            crate::distribution::RELEASE_DOWNLOAD_PREFIX
+        );
+        if asset_url == expected_url {
+            return Ok(name.clone());
+        }
+    }
+    Err(format!(
+        "preview asset {asset_key} must use {}v{release_version}/{} or {}v{release_version}/{}",
+        crate::distribution::RELEASE_DOWNLOAD_PREFIX,
+        names[0],
+        crate::distribution::RELEASE_DOWNLOAD_PREFIX,
+        names[1]
+    ))
 }
 
