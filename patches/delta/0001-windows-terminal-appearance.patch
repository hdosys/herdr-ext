+
+fn packed_color_rgb(value: u32) -> Option<(u8, u8, u8)> {
+    match value >> 24 {
+        0x00 => match value & 0xff {
+            0x01 => Some((0, 0, 0)),
+            0x02 => Some((128, 0, 0)),
+            0x03 => Some((0, 128, 0)),
+            0x04 => Some((128, 128, 0)),
+            0x05 => Some((0, 0, 128)),
+            0x06 => Some((128, 0, 128)),
+            0x07 => Some((0, 128, 128)),
+            0x08 => Some((192, 192, 192)),
+            0x09 => Some((128, 128, 128)),
+            0x0a => Some((255, 0, 0)),
+            0x0b => Some((0, 255, 0)),
+            0x0c => Some((255, 255, 0)),
+            0x0d => Some((0, 0, 255)),
+            0x0e => Some((255, 0, 255)),
+            0x0f => Some((0, 255, 255)),
+            0x10 => Some((255, 255, 255)),
+            _ => None,
+        },
+        0x02 => Some((
+            ((value >> 16) & 0xff) as u8,
+            ((value >> 8) & 0xff) as u8,
+            (value & 0xff) as u8,
+        )),
+        _ => None,
+    }
+}
