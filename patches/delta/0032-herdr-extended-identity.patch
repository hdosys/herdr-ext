diff --git a/docs/next/website/src/content/docs/windows-beta.mdx b/docs/next/website/src/content/docs/windows-beta.mdx
index 854624ab1f420b844f86a3014a773b65f919e4a8..239fd0a3092a4543a90fa8df5b620e640b4298c4 100644
