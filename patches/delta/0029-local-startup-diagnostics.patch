diff --git a/src/client/startup.rs b/src/client/startup.rs
index 40ee2cc8e82b58f8ab5ed94cc97232aa126d8060..be389167f24537d59bdb78cbd5eb1a24e2122a95 100644
--- a/src/client/startup.rs
