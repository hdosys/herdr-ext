From 800617242cd8663bb899fa66f2e924ac9a679e29 Mon Sep 17 00:00:00 2001
From: User-3090 <71881005+User-3090@users.noreply.github.com>
Date: Thu, 10 Sep 2026 16:13:05 +0200
Subject: [PATCH] feat(client): surface machine setup in menu

---
 src/client/shell/global_menu.rs            |  7 +++++++
 src/client/shell/tests/chrome_context.rs   | 11 +++++++++++
 src/client/shell/tests/startup_overlays.rs |  4 ++--
 3 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/client/shell/global_menu.rs b/src/client/shell/global_menu.rs
index e5bd6f78b43a4ef305b590f2d7c53a4ad97970a8..e27df8419c18b5facf74c8557cad102986321bf8 100644
--- a/src/client/shell/global_menu.rs
+++ b/src/client/shell/global_menu.rs
@@ -3,6 +3,7 @@ use super::*;
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub(super) enum ClientGlobalMenuAction {
     Binding(crate::input::KeybindAction),
+    AddMachine,
     WhatsNew,
 }
 
@@ -35,6 +36,7 @@ pub(super) fn global_menu_items(
             "reload config",
             ClientGlobalMenuAction::Binding(crate::input::KeybindAction::ReloadConfig),
         ),
+        ("add machine...", ClientGlobalMenuAction::AddMachine),
     ];
     if snapshot.update_available.is_some() || snapshot.latest_release_notes_available {
         items.push((
@@ -103,6 +105,11 @@ impl ClientShellState {
             ClientGlobalMenuAction::Binding(binding) => {
                 self.record_binding(crate::input::KeybindMatch::Action(binding), outcome)
             }
+            ClientGlobalMenuAction::AddMachine => outcome.actions.push(
+                ClientShellAction::OpenSafeWebUrl(
+                    "https://herdr.dev/docs/connecting-machines/".to_owned(),
+                ),
+            ),
             ClientGlobalMenuAction::WhatsNew => self.open_release_notes(),
         }
         outcome.repaint = true;
diff --git a/src/client/shell/tests/chrome_context.rs b/src/client/shell/tests/chrome_context.rs
index 1ef98798ec8613b20f8b6ebea89773baeb414816..50392c45d089c2f75da67e38ce6f6794af1a4c29 100644
--- a/src/client/shell/tests/chrome_context.rs
+++ b/src/client/shell/tests/chrome_context.rs
@@ -407,6 +407,7 @@ fn global_menu_opens_from_sidebar_and_routes_client_actions() {
     assert!(text.contains("settings"));
     assert!(text.contains("keybinds"));
     assert!(text.contains("reload config"));
+    assert!(text.contains("add machine..."));
     assert!(text.contains("detach"));
 
     let keybinds = state.hits.global_menu_rows[1].0;
@@ -422,6 +423,16 @@ fn global_menu_opens_from_sidebar_and_routes_client_actions() {
     state.overlay = Some(ClientShellOverlay::GlobalMenu(ClientGlobalMenuOverlay {
         highlighted: 3,
     }));
+    let machine_setup = state.handle_input_bytes(b"\r");
+    assert!(matches!(
+        &machine_setup.actions[..],
+        [ClientShellAction::OpenSafeWebUrl(url)]
+            if url == "https://herdr.dev/docs/connecting-machines/"
+    ));
+
+    state.overlay = Some(ClientShellOverlay::GlobalMenu(ClientGlobalMenuOverlay {
+        highlighted: 4,
+    }));
     let detach = state.handle_input_bytes(b"\r");
     assert!(detach.detach);
     assert!(state.overlay.is_none());
diff --git a/src/client/shell/tests/startup_overlays.rs b/src/client/shell/tests/startup_overlays.rs
index bddcde10c8a53adbccea133d7248b0e0e86cb9c4..5b99a6567acbe3af5fb7b0a18dc443797448c327 100644
--- a/src/client/shell/tests/startup_overlays.rs
+++ b/src/client/shell/tests/startup_overlays.rs
@@ -730,7 +730,7 @@ fn update_ready_menu_opens_client_owned_release_notes_and_dismisses_by_version()
         .collect::<Vec<_>>()
         .join("\n");
     assert!(text.contains("● update ready"));
-    let update_row = state.hits.global_menu_rows[3].0;
+    let update_row = state.hits.global_menu_rows[4].0;
     assert_eq!(update_row.width, 16);
     let menu_buffer = menu.to_ratatui_buffer().expect("menu buffer");
     assert_eq!(
@@ -741,7 +741,7 @@ fn update_ready_menu_opens_client_owned_release_notes_and_dismisses_by_version()
         menu_buffer[(update_row.x + 3, update_row.y)].fg,
         state.config.palette.text
     );
-    state.activate_global_menu_item(3, &mut ClientShellInput::default());
+    state.activate_global_menu_item(4, &mut ClientShellInput::default());
     let notes = state.compose(106, 30).expect("release notes");
     let bottom_row_start = usize::from(notes.width) * usize::from(notes.height - 1);
     let bottom_row = notes.cells[bottom_row_start..]
-- 
2.56.0.windows.3

