+fn prepare_remote_attachment(
+    ssh: &RemoteSsh,
+    detected: DetectedRemoteHost,
+    live_handoff: bool,
+    yes: bool,
+    override_binary: Option<PathBuf>,
+    require_surface_interest: bool,
