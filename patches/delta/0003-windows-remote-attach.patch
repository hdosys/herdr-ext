+    let root = windows_sidecar_root(remote_herdr);
+    let (parent, _) = root.rsplit_once('\\').ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("Windows remote sidecar root has no parent: {root}"),
+        )
+    })?;
+    Ok(format!("{parent}\\{archive_name}"))
+}
