+        }
+        let archive_sha256 = file_sha256(&archive)?;
+        Ok(InstallSource::local_windows_zip(
+            archive.clone(),
+            temporary_dir.clone(),
+            archive_sha256,
+            executable_sha256,
+        ))
+    })();
+    if result.is_err() {
+        let _ = fs::remove_dir_all(&temporary_dir);
+    }
