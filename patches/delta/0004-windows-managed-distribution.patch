+fn is_fork_build_id(value: &str) -> bool {
+    let mut parts = value.split('.');
+    let Some(upstream) = parts.next() else {
+        return false;
+    };
+    let Some(control) = parts.next() else {
+        return false;
+    };
+    parts.next().is_none()
+        && upstream.len() == 12
+        && control.len() == 12
+        && upstream
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        && control
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
