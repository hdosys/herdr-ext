+$skillText = (New-Object Text.UTF8Encoding($false, $true)).GetString([IO.File]::ReadAllBytes($skillSource))
+$skillValidationText = $skillText.Replace("`r`n", "`n")
+if ($skillValidationText.Contains("`r") -or
