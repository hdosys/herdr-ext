+    bytes = [long]$artifact.Length
+    sha256 = Get-Sha256 -Path $artifact.FullName
+    nsis = "v$NsisVersion"
+}).GetEnumerator() | ForEach-Object { "{0}={1}" -f $_.Key, $_.Value }
