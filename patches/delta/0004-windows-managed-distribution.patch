+        fn terminate_and_wait(&mut self, timeout: Duration) {
+            // SAFETY: the guard owns a live test-only process handle with
+            // PROCESS_TERMINATE rights.
+            assert_ne!(unsafe { TerminateProcess(self.handle, 1) }, 0);
+            self.wait(timeout);
+        }
+    }
