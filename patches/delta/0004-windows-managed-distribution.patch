+            // SAFETY: test-only emergency cleanup for a helper PID. Production
+            // launcher code never terminates processes.
+            unsafe {
+                if !self.exited {
+                    TerminateProcess(self.handle, 1);
+                    WaitForSingleObject(self.handle, 5_000);
+                }
+                CloseHandle(self.handle);
+            }
+        }
