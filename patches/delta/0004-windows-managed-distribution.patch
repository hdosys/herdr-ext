-function Move-DirectoryWithRetry {
-    param(
-        [string]$Source,
-        [string]$Destination,
-        [int]$TimeoutMilliseconds = 5000
-    )
-
-    $deadline = [DateTime]::UtcNow.AddMilliseconds($TimeoutMilliseconds)
