+            "2026.08.28.1045Z (local, build 0123456789ab.cdef01234567.extra)",
+            "00.8.0-preview.0123456789ab.cdef01234567",
+            "0.8.0-preview.0123456789ab.cdef01234567.extra",
+            "0.8-preview.0123456789ab.cdef01234567",
