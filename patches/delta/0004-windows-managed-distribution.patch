+        assert_eq!(
+            release.release_version,
+            ReleaseVersion::parse("2026.07.31.1")
+        );
+        assert_eq!(
+            release.sha256.as_deref(),
+            Some("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
