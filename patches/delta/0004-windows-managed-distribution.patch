+    if ($malformedPendingExit -eq 0 -or
+        -not (Test-Path -LiteralPath $malformedPendingLauncher -PathType Leaf) -or
+        -not (Test-Path -LiteralPath (Join-Path $installRoot "bin\herdr.exe") -PathType Leaf) -or
