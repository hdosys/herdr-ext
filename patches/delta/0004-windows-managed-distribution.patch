+$skillHashManifestText = (New-Object Text.UTF8Encoding($false, $true)).GetString([IO.File]::ReadAllBytes($skillHashManifest))
+$skillHashManifestValidationText = $skillHashManifestText.Replace("`r`n", "`n")
