-
-    $curl = Get-Command curl.exe -CommandType Application -ErrorAction SilentlyContinue |
-        Select-Object -First 1
-    if ($null -eq $curl) {
-        throw "Herdr installation requires curl.exe, which is included with supported Windows versions."
-    }
-
-    $arguments = @(
-        "--fail",
-        "--silent",
-        "--show-error",
-        "--location",
-        "--connect-timeout", "30",
-        "--speed-limit", "1024",
-        "--speed-time", "30"
