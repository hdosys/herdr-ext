+        fs::create_dir(&state).unwrap();
+        let malformed = state.join("launcher.pending-not-a-hash.exe");
+        fs::write(&malformed, b"fixture").unwrap();
+        let result = pending_launcher(&state);
+        fs::remove_file(malformed).unwrap();
