From: User-3090 <71881005+User-3090@users.noreply.github.com>
Date: Sun, 30 Aug 2026 17:21:35 +0200
Subject: [PATCH 12/29] fix(ui): keep muted labels readable

Refs herdrdev/herdr#2692
---
 src/client/shell/agent_sidebar.rs | 12 ++----------
 src/client/shell/sidebar.rs       |  4 +---
 src/client/shell/tabs.rs          |  5 +----
 src/ui/sidebar.rs                 |  4 +---
 4 files changed, 5 insertions(+), 20 deletions(-)

diff --git a/src/client/shell/agent_sidebar.rs b/src/client/shell/agent_sidebar.rs
index d6fe33529bec9df903a56ca4523a48677b6c2724..e7ebabf3dea1f210efaa3bf6db598a8fc42f2a56 100644
--- a/src/client/shell/agent_sidebar.rs
+++ b/src/client/shell/agent_sidebar.rs
@@ -332,16 +332,8 @@ pub(super) fn render_agent_row(
             .fg(palette.subtext0)
             .add_modifier(Modifier::BOLD)
     };
-    let status_style = Style::default()
-        .fg(status_color(row.status, palette))
-        .add_modifier(if row.focused {
-            Modifier::empty()
-        } else {
-            Modifier::DIM
-        });
-    let secondary = Style::default()
-        .fg(palette.overlay0)
-        .add_modifier(Modifier::DIM);
+    let status_style = Style::default().fg(status_color(row.status, palette));
+    let secondary = Style::default().fg(palette.overlay0);
     let icon = (
         status_icon(row.status, config.status_indicators),
         Style::default().fg(status_color(row.status, palette)),
diff --git a/src/client/shell/sidebar.rs b/src/client/shell/sidebar.rs
index 0aaa0d51ea371ca56335506055d48c027ed39008..afb6047f15147eee59fb645026420a8c01da6288 100644
--- a/src/client/shell/sidebar.rs
+++ b/src/client/shell/sidebar.rs
@@ -679,9 +679,7 @@ pub(in crate::client::shell) fn render_workspace_rows(
                 status_icon(status, indicators),
                 Style::default().fg(status_color(status, palette)),
             ),
-            Style::default()
-                .fg(status_color(status, palette))
-                .add_modifier(Modifier::DIM),
+            Style::default().fg(status_color(status, palette)),
             workspace_style,
             secondary_style,
             Style::default().fg(palette.overlay1),
diff --git a/src/client/shell/tabs.rs b/src/client/shell/tabs.rs
index cf179d8080b1c04ebe5a9dc5e2216fae0246ac21..9e9901ff0b79f7244e1a4fdd349ab5beeed7dad2 100644
--- a/src/client/shell/tabs.rs
+++ b/src/client/shell/tabs.rs
@@ -112,10 +112,7 @@ pub(crate) fn render_tab_bar(
         } else if tab.custom_label {
             Style::default().fg(palette.overlay1).bg(palette.surface0)
         } else {
-            Style::default()
-                .fg(palette.overlay0)
-                .bg(palette.surface0)
-                .add_modifier(Modifier::DIM)
+            Style::default().fg(palette.overlay0).bg(palette.surface0)
         };
         let padding = width.saturating_sub(display_width(&name));
         let left = padding / 2;
diff --git a/src/ui/sidebar.rs b/src/ui/sidebar.rs
index 178bdb1f6590cead3adfba4b99ab281687a9e72b..cbf6f1a97b49aebd4a0acc61028031517d7f417b 100644
--- a/src/ui/sidebar.rs
+++ b/src/ui/sidebar.rs
@@ -219,9 +219,7 @@ pub(crate) fn resolved_token_spans(
             let previous = &resolved[visible_indices[position - 1]];
             spans.push(Span::styled(
                 tokens::separator(previous, token),
-                Style::default()
-                    .fg(palette.overlay0)
-                    .add_modifier(Modifier::DIM),
+                Style::default().fg(palette.overlay0),
             ));
         }
         match &token.kind {
